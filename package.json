{
  "name": "lociview",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:harness": "vite build --mode spark-harness",
    "preview": "vite preview",
    "preview:harness": "vite preview --outDir dev-dist --port 4181 --strictPort",
    "evidence:verify": "node scripts/verify-g0-evidence.mjs",
    "fixtures:verify": "node scripts/fixtures/verify.mjs",
    "fixtures:release:restore": "node scripts/fixtures/restore-release-fixture.mjs",
    "fixtures:receipt:verify": "node scripts/fixtures/verify-acquisition-receipt.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.7.52",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@sparkjsdev/spark": "2.1.0",
    "@types/node": "^26.1.1",
    "@types/three": "0.180.0",
    "ajv": "8.20.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0"
  }
}
