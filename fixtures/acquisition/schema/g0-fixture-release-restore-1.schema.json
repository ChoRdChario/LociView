{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lociview.example/schemas/g0-fixture-release-restore-1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "requestId",
    "locator",
    "expectedSha256",
    "expectedBytes"
  ],
  "properties": {
    "$schema": {
