    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}(?![\\s\\S])"
    },
    "locator": {
      "type": "string",
      "pattern": "^https://github\\.com/ChoRdChario/LociView/releases/download/fixtures-v[0-9]+(?:\\.[0-9]+)*/(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$))[A-Za-z0-9](?:[A-Za-z0-9._-]{0,253}[A-Za-z0-9])?(?![\\s\\S])"
    },
    "expectedSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "expectedBytes": {
