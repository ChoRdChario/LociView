{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lociview.example/schemas/g0-fixture-registry-v2.json",
  "title": "LociView G0 fixture registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "registryVersion", "fixtures"],
  "properties": {
    "$schema": { "const": "./registry.schema.json" },
    "registryVersion": { "const": 2 },
    "fixtures": { "type": "array", "items": { "$ref": "#/$defs/fixture" } }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableText": {
      "anyOf": [
        { "type": "string", "minLength": 1, "maxLength": 2048 },
        { "type": "null" }
      ]
    },
    "publicHttpsUrl": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://(?![^/?#]*@)(?!\\[)(?!(?:0x[0-9a-f]+|[0-9]+)(?:\\.(?:0x[0-9a-f]+|[0-9]+)){0,3}(?::[0-9]+)?(?:[/?#]|$))(?!(?:[a-z0-9-]+\\.)*(?:localhost|local|internal|invalid|test|example|onion|home|lan)(?::[0-9]+)?(?:[/?#]|$))(?!(?:[a-z0-9-]+\\.)*home\\.arpa(?::[0-9]+)?(?:[/?#]|$))(?=[a-z0-9.-]*\\.)[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?(?::0*(?:[0-9]{1,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][^\\s]*)?$"
    },
    "nullableHttpsUrl": {
      "anyOf": [
        { "$ref": "#/$defs/publicHttpsUrl" },
        { "type": "null" }
      ]
    },
    "boundGitFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creators", "title", "creditLine", "copyrightNotice", "sourceUrl", "licenseNotice", "disclaimerNotice", "retainedNotices", "modified", "modificationNotice"],
      "properties": {
        "creators": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "title": { "$ref": "#/$defs/nullableText" },
        "creditLine": { "$ref": "#/$defs/nullableText" },
        "copyrightNotice": { "$ref": "#/$defs/nullableText" },
        "sourceUrl": { "$ref": "#/$defs/nullableHttpsUrl" },
        "licenseNotice": { "$ref": "#/$defs/nullableText" },
        "disclaimerNotice": { "$ref": "#/$defs/nullableText" },
        "retainedNotices": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
        },
        "modified": { "type": "boolean" },
        "modificationNotice": { "$ref": "#/$defs/nullableText" }
      },
      "allOf": [
        {
          "if": { "properties": { "modified": { "const": true } }, "required": ["modified"] },
          "then": { "properties": { "modificationNotice": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "reviewStatus", "licenseUrl", "licenseText", "attribution"],
      "properties": {
        "spdx": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reviewStatus": { "enum": ["unreviewed", "approved"] },
        "licenseUrl": { "$ref": "#/$defs/nullableHttpsUrl" },
        "licenseText": {
          "anyOf": [
            { "$ref": "#/$defs/boundGitFile" },
            { "type": "null" }
          ]
        },
        "attribution": {
          "anyOf": [
            { "$ref": "#/$defs/attribution" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "reviewStatus": { "const": "unreviewed" } }, "required": ["reviewStatus"] },
          "then": {
            "properties": {
              "spdx": { "const": "NOASSERTION" },
              "licenseUrl": { "type": "null" },
              "licenseText": { "type": "null" },
              "attribution": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "reviewStatus": { "const": "approved" } }, "required": ["reviewStatus"] },
          "then": {
            "properties": {
              "spdx": { "enum": ["CC-BY-4.0", "CC0-1.0"] },
              "attribution": { "$ref": "#/$defs/attribution" }
            },
            "anyOf": [
              { "properties": { "licenseUrl": { "type": "string" } } },
              { "properties": { "licenseText": { "$ref": "#/$defs/boundGitFile" } } }
            ]
          }
        },
        {
          "if": { "properties": { "spdx": { "const": "CC-BY-4.0" } }, "required": ["spdx"] },
          "then": {
            "properties": {
              "reviewStatus": { "const": "approved" },
              "licenseUrl": { "const": "https://creativecommons.org/licenses/by/4.0/" },
              "attribution": {
                "type": "object",
                "properties": {
                  "creators": { "type": "array", "minItems": 1 },
                  "creditLine": { "type": "string", "minLength": 1 },
                  "sourceUrl": { "$ref": "#/$defs/publicHttpsUrl" },
                  "modificationNotice": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "spdx": { "const": "CC0-1.0" },
              "licenseUrl": { "type": "string" }
            },
            "required": ["spdx", "licenseUrl"]
          },
          "then": {
            "properties": {
              "licenseUrl": { "const": "https://creativecommons.org/publicdomain/zero/1.0/" }
            }
          }
        }
      ]
    },
    "storage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier", "path"],
          "properties": {
            "tier": { "const": "git" },
            "path": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier", "path"],
          "properties": {
            "tier": { "const": "generated" },
            "path": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier", "transport"],
          "properties": {
            "tier": { "const": "external" },
            "transport": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "locator", "retentionPolicy"],
              "properties": {
                "kind": { "const": "github-release-asset" },
                "locator": {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^https://github\\.com/ChoRdChario/LociView/releases/download/fixtures-v[0-9]+(?:\\.[0-9]+)*/(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$))[A-Za-z0-9](?:[A-Za-z0-9._-]{0,253}[A-Za-z0-9])?$"
                },
                "retentionPolicy": { "const": "versioned-no-overwrite" }
              }
            }
          }
        }
      ]
    },
    "semanticContractFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "semanticContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "profileId", "specification", "oracle"],
      "properties": {
        "status": { "const": "candidate" },
        "profileId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$" },
        "specification": { "$ref": "#/$defs/semanticContractFile" },
        "oracle": { "$ref": "#/$defs/semanticContractFile" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "storage", "byteSize", "sha256", "mediaType", "classification", "geometry", "coordinates", "provenance", "license", "privacy", "restore", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$" },
        "storage": { "$ref": "#/$defs/storage" },
        "byteSize": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 128 },
        "classification": { "enum": ["mesh", "ordinary-point-cloud", "gaussian-splat", "package", "evidence"] },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["triangleCount", "ordinaryPointCount", "splatCount", "textureCount", "bounds"],
          "properties": {
            "triangleCount": { "type": "integer", "minimum": 0 },
            "ordinaryPointCount": { "type": "integer", "minimum": 0 },
            "splatCount": { "type": "integer", "minimum": 0 },
            "textureCount": { "type": "integer", "minimum": 0 },
            "bounds": {
              "type": "object",
              "additionalProperties": false,
              "required": ["min", "max"],
              "properties": { "min": { "$ref": "#/$defs/vec3" }, "max": { "$ref": "#/$defs/vec3" } }
            }
          }
        },
        "coordinates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["handedness", "upAxis", "unit"],
          "properties": {
            "handedness": { "enum": ["right", "left", "unspecified"] },
            "upAxis": { "enum": ["+X", "+Y", "+Z", "unspecified"] },
            "unit": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source", "reproducibility"],
          "properties": {
            "kind": { "enum": ["authored", "generated", "anonymized-derived", "third-party"] },
            "source": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "reproducibility": { "enum": ["pinned-output-only", "byte-reproducible", "external-restore"] }
          }
        },
        "license": { "$ref": "#/$defs/license" },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content", "personalData", "anonymization", "reviewStatus"],
          "properties": {
            "content": { "enum": ["synthetic", "anonymized-derived"] },
            "personalData": { "const": false },
            "anonymization": { "type": "string", "minLength": 1, "maxLength": 256 },
            "reviewStatus": { "enum": ["unreviewed", "approved"] }
          }
        },
        "restore": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "instructions"],
          "properties": {
            "method": { "enum": ["repository", "generate", "external"] },
            "instructions": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "warnings"],
          "properties": {
            "classification": { "enum": ["mesh", "ordinary-point-cloud", "gaussian-splat", "package", "evidence"] },
            "warnings": { "type": "array", "items": { "type": "string", "maxLength": 256 } }
          }
        },
        "semanticContract": { "$ref": "#/$defs/semanticContract" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "storage": {
                "type": "object",
                "properties": { "tier": { "const": "git" } },
                "required": ["tier"]
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "type": "object",
                "properties": { "reproducibility": { "enum": ["pinned-output-only", "byte-reproducible"] } }
              },
              "restore": {
                "type": "object",
                "properties": { "method": { "const": "repository" } }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "storage": {
                "type": "object",
                "properties": { "tier": { "const": "generated" } },
                "required": ["tier"]
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "type": "object",
                "properties": {
                  "kind": { "const": "generated" },
                  "reproducibility": { "const": "byte-reproducible" }
                }
              },
              "restore": {
                "type": "object",
                "properties": { "method": { "const": "generate" } }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "storage": {
                "type": "object",
                "properties": { "tier": { "const": "external" } },
                "required": ["tier"]
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "type": "object",
                "properties": { "reproducibility": { "const": "external-restore" } }
              },
              "license": {
                "type": "object",
                "properties": { "reviewStatus": { "const": "approved" } }
              },
              "privacy": {
                "type": "object",
                "properties": { "reviewStatus": { "const": "approved" } }
              },
              "restore": {
                "type": "object",
                "properties": { "method": { "const": "external" } }
              },
              "expected": {
                "type": "object",
                "properties": {
                  "warnings": {
                    "type": "array",
                    "contains": { "const": "External transport identity requires separate acquisition verification." }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance": {
                "type": "object",
                "properties": { "kind": { "const": "third-party" } },
                "required": ["kind"]
              }
            }
          },
          "then": {
            "properties": {
              "license": {
                "type": "object",
                "properties": { "reviewStatus": { "const": "approved" } }
              },
              "privacy": {
                "type": "object",
                "properties": { "reviewStatus": { "const": "approved" } }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance": {
                "type": "object",
                "properties": { "kind": { "const": "anonymized-derived" } },
                "required": ["kind"]
              }
            }
          },
          "then": {
            "properties": {
              "license": {
                "type": "object",
                "properties": { "reviewStatus": { "const": "approved" } }
              },
              "privacy": {
                "type": "object",
                "properties": { "content": { "const": "anonymized-derived" } }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "privacy": {
                "type": "object",
                "properties": { "content": { "const": "anonymized-derived" } },
                "required": ["content"]
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "type": "object",
                "properties": { "kind": { "const": "anonymized-derived" } }
              },
              "license": {
                "type": "object",
                "properties": { "reviewStatus": { "const": "approved" } }
              },
              "privacy": {
                "type": "object",
                "properties": {
                  "anonymization": {
                    "type": "string",
                    "minLength": 16,
                    "pattern": "^\\s*\\S[\\s\\S]{14,}\\S\\s*$",
                    "not": { "pattern": "^\\s*(?:[Nn][Oo][Tt]-[Aa][Pp][Pp][Ll][Ii][Cc][Aa][Bb][Ll][Ee]|[Nn][Oo][Nn][Ee]|[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Nn]/[Aa])\\s*$" }
                  },
                  "reviewStatus": { "const": "approved" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance": {
                "type": "object",
                "properties": { "kind": { "const": "authored" } },
                "required": ["kind"]
              }
            }
          },
          "then": {
            "properties": {
              "storage": {
                "type": "object",
                "properties": { "tier": { "const": "git" } }
              },
              "provenance": {
                "type": "object",
                "properties": { "reproducibility": { "const": "pinned-output-only" } }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "classification": { "const": "ordinary-point-cloud" } },
            "required": ["classification"]
          },
          "then": {
            "properties": {
              "geometry": {
                "type": "object",
                "properties": { "splatCount": { "const": 0 } }
              }
            }
          }
        },
        {
          "if": {
            "required": ["classification"],
            "properties": { "classification": { "const": "gaussian-splat" } }
          },
          "then": {
            "required": ["semanticContract"],
            "properties": {
              "semanticContract": { "$ref": "#/$defs/semanticContract" },
              "storage": {
                "type": "object",
                "properties": { "tier": { "enum": ["git", "external"] } }
              },
              "geometry": {
                "type": "object",
                "properties": {
                  "triangleCount": { "const": 0 },
                  "ordinaryPointCount": { "const": 0 },
                  "splatCount": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["semanticContract"],
            "properties": {
              "semanticContract": {
                "type": "object",
                "required": ["status"],
                "properties": { "status": { "const": "candidate" } }
              }
            }
          },
          "then": {
            "properties": {
              "expected": {
                "type": "object",
                "properties": {
                  "warnings": {
                    "type": "array",
                    "contains": { "const": "Candidate semantic contract is not ratified renderer or device evidence." }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
