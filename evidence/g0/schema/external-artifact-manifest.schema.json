{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lociview.example/schemas/g0-external-artifact-manifest-1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "manifestId", "runId", "artifacts", "notes"],
  "properties": {
    "schemaVersion": { "const": "g0-external-artifact-manifest-1" },
    "status": { "enum": ["pending", "recorded"] },
    "manifestId": { "type": ["string", "null"], "pattern": "^art_[a-z0-9][a-z0-9._-]{2,95}$" },
    "runId": { "type": ["string", "null"], "pattern": "^run_[a-z0-9][a-z0-9._-]{2,95}$" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "kind", "sha256", "bytes", "storageLocator", "restoreInstructions", "capturedAtUtc", "containsSensitiveData", "retentionNote"],
        "properties": {
          "artifactId": { "type": "string", "pattern": "^blob_[a-z0-9][a-z0-9._-]{2,95}$" },
          "kind": { "enum": ["camera-input-trace", "screen-capture", "video", "browser-trace", "safari-trace", "raw-log", "large-fixture", "other"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "storageLocator": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "restoreInstructions": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "capturedAtUtc": { "type": "string", "format": "utc-date-time" },
          "containsSensitiveData": { "type": "boolean" },
          "retentionNote": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string", "maxLength": 512 } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "recorded" } }, "required": ["status"] },
      "then": {
        "properties": {
          "manifestId": { "type": "string" },
          "runId": { "type": "string" },
          "artifacts": { "type": "array", "minItems": 1 }
        }
      }
    }
  ]
}
