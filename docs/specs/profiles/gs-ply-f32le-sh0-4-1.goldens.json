    "colorVectorDegree": "smallest complete degree containing the largest stated basis index; G/B coefficients default0",
    "representationToAsset": "canonical identity unless a frame vector explicitly supplies it"
  },
  "comparisons": {
    "schemaCountsPropertyNamesRawBits": "exact",
    "derivedZeroSign": "positive zero",
    "smallMathVectors": {
      "fields": [
        "normalizedQuaternion",
        "covariance",
        "opacity",
        "nonlinearColor",
        "linearColor"
      ],
      "absoluteTolerance": 1e-12,
      "relativeTolerance": 1e-12,
      "predicate": "abs(actual-expected)<=max(absTolerance,relTolerance*abs(expected))"
    },
    "bounds": "use source profile raw-containment and padded-union comparison; no generic approximate equality",
    "scope": "these small reference vectors only, not arbitrary-input error or renderer precision guarantees"
  },
  "canonicalByteRecipe": {
    "appliesTo": [
      "schemaVectors",
      "geometryVectors",
      "colorVectors"
    ],
    "excludes": "frameVectors are independent post-activation mean/covariance transform oracles, not Float32 PLY recipes; opacityVectors are scalar activation oracles, not assertions of whole-file admission",
    "header": "ply LF; format binary_little_endian 1.0 LF; element vertex N LF; exact ordered property float NAME LF lines from selected schema; end_header LF; no metadata",
    "payload": "one full scalar row per eligible vector in exact schema order, each value rounded to IEEE754 binary32 and little-endian encoded, no trailing bytes"
  },
