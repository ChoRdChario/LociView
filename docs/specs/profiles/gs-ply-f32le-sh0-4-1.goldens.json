{
  "format": "lociview-gs-source-golden-vectors",
  "version": 1,
  "scope": "Project-owned mathematical/byte recipes; proposed normative inputs, not executed device or renderer evidence.",
  "defaults": {
    "geometryDegree": 0,
    "encodedLogitF32": 0,
    "normalF32": [
      0,
      0,
      0
